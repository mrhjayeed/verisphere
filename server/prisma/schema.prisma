generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  passwordHash   String
  displayName    String
  role           String   @default("citizen") // citizen | admin
  isAnonymousAlias Boolean @default(false)
  createdAt      DateTime @default(now())

  submissions           WhistleblowerSubmission[]
  civicReports          CivicReport[]
  knowledgeArticles     KnowledgeArticle[]
  forumThreads          ForumThread[]
  forumComments         ForumComment[]
  evidenceItems         EvidenceItem[]
  opinionPosts          OpinionPost[]
  opinionComments       OpinionComment[]
  investigationContributions InvestigationContribution[]
}

model WhistleblowerSubmission {
  id           String   @id @default(uuid())
  trackingCode String?  @unique
  submitterId  String?
  title        String
  description  String   @db.Text
  category     String
  status       String   @default("received") // received | under_review | resolved | dismissed
  createdAt    DateTime @default(now())

  submitter    User?            @relation(fields: [submitterId], references: [id])
  files        SubmissionFile[]
}

model SubmissionFile {
  id           String   @id @default(uuid())
  submissionId String
  filePath     String
  originalName String
  uploadedAt   DateTime @default(now())

  submission   WhistleblowerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model CivicReport {
  id           String   @id @default(uuid())
  authorId     String?
  title        String
  description  String   @db.Text
  category     String   // corruption | abuse_of_authority | human_rights | environment | public_service | misuse_of_resources | infrastructure | election
  location     String?
  incidentDate DateTime?
  status       String   @default("received") // received | under_review | resolved | dismissed
  createdAt    DateTime @default(now())

  author       User?            @relation(fields: [authorId], references: [id])
  files        CivicReportFile[]
  complaints   OfficialComplaint[]
}

model CivicReportFile {
  id           String   @id @default(uuid())
  reportId     String
  filePath     String
  originalName String
  uploadedAt   DateTime @default(now())

  report       CivicReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Official {
  id          String   @id @default(uuid())
  name        String
  position    String
  institution String
  bio         String?  @db.Text
  photoPath   String?
  createdAt   DateTime @default(now())

  promises      OfficialPromise[]
  controversies OfficialControversy[]
  complaints    OfficialComplaint[]
}

model OfficialPromise {
  id         String @id @default(uuid())
  officialId String
  text       String @db.Text
  status     String @default("pending") // kept | broken | pending

  official   Official @relation(fields: [officialId], references: [id], onDelete: Cascade)
}

model OfficialControversy {
  id          String @id @default(uuid())
  officialId  String
  title       String
  description String @db.Text
  sourceUrl   String?

  official    Official @relation(fields: [officialId], references: [id], onDelete: Cascade)
}

model OfficialComplaint {
  id         String   @id @default(uuid())
  officialId String
  reportId   String?
  text       String   @db.Text
  createdAt  DateTime @default(now())

  official   Official    @relation(fields: [officialId], references: [id], onDelete: Cascade)
  report     CivicReport? @relation(fields: [reportId], references: [id])
}

model KnowledgeArticle {
  id        String   @id @default(uuid())
  title     String
  category  String
  content   String   @db.Text
  authorId  String
  createdAt DateTime @default(now())

  author    User @relation(fields: [authorId], references: [id])
}

model ForumThread {
  id        String   @id @default(uuid())
  title     String
  body      String   @db.Text
  authorId  String
  createdAt DateTime @default(now())

  author    User           @relation(fields: [authorId], references: [id])
  comments  ForumComment[]
}

model ForumComment {
  id        String   @id @default(uuid())
  threadId  String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id])
}

model EvidenceItem {
  id            String   @id @default(uuid())
  title         String
  description   String?  @db.Text
  filePath      String
  originalName  String
  fileType      String
  category      String
  sourceRef     String?
  uploadedById  String
  createdAt     DateTime @default(now())

  uploadedBy    User @relation(fields: [uploadedById], references: [id])
}

model OpinionPost {
  id        String   @id @default(uuid())
  title     String
  body      String   @db.Text
  authorId  String
  createdAt DateTime @default(now())

  author    User              @relation(fields: [authorId], references: [id])
  comments  OpinionComment[]
}

model OpinionComment {
  id        String   @id @default(uuid())
  opinionId String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  opinion   OpinionPost @relation(fields: [opinionId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id])
}

model Investigation {
  id        String   @id @default(uuid())
  title     String
  summary   String   @db.Text
  status    String   @default("open") // open | closed
  createdAt DateTime @default(now())

  contributions InvestigationContribution[]
}

model InvestigationContribution {
  id              String   @id @default(uuid())
  investigationId String
  contributorId   String
  type            String   // document | evidence | note | timeline_entry
  body            String?  @db.Text
  filePath        String?
  createdAt       DateTime @default(now())

  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  contributor     User          @relation(fields: [contributorId], references: [id])
}
